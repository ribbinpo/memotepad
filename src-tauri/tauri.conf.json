{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memotepad",
  "version": "0.4.0",
  "identifier": "com.poom.memotepad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 360,
        "height": 420,
        "minWidth": 240,
        "minHeight": 200,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://r2-dev.ribbinpo.dev/memotepad/releases/latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEN0ZERUREOTBCRUZBOTgKUldTWStyNlEzZDUvblV6RmRhT2NpZU1BY1QyVzFtMnEwQUNmKzl6ZUloR21ybktDNnF1bCttYmkK"
    }
  }
}