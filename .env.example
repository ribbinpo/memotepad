# Cloudflare R2 credentials for local publishing (see .claude/skills/release-r2).
# Copy to `.env` and fill in — `.env` is git-ignored. In CI these are the
# repository secrets of the same names.

# Cloudflare account id — the endpoint is https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" on the bucket below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket the .dmg files are uploaded to
R2_BUCKET=

# Optional. Key prefix for uploaded artifacts (default: memotepad/releases)
#R2_PREFIX=memotepad/releases
# Optional. Public base URL — printed after upload, and used for the download
# URLs inside the updater manifest (latest.json). Must match the updater
# endpoint baked into src-tauri/tauri.conf.json (this is also the default).
#R2_PUBLIC_BASE_URL=https://r2-dev.ribbinpo.dev

# Tauri updater signing key. Generate once with
#   npm run tauri signer generate -- -w ~/.tauri/memotepad.key
# then keep the private key safe — losing it means shipped apps can never
# accept another update. Path to the key file or the key content both work.
TAURI_SIGNING_PRIVATE_KEY=~/.tauri/memotepad.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
